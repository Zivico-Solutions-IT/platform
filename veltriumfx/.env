# VeltriumFX Local development environment (VPS 2 Instance).
NODE_ENV=development
HOST=0.0.0.0
PORT=5001

# ─── MASTER CONTROL ────────────────────────────────────────────────────────────
# Set to false to disable local master login on VeltriumFX platform.
# Master control is executed from NovaFXM platform (VPS 1) via signed Master tokens.
ENABLE_MASTER=false

# ─── DATABASE (VPS 2 Separate Database) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=veltriumfx_db
DB_USER=root
DB_PASSWORD=1234

# Production DB (Hostinger / VPS 2) — uncomment when deploying on VPS 2
# DB_HOST=srv1853.hstgr.io
# DB_PORT=3306
# DB_NAME=u512178113_veltriumfx_db
# DB_USER=u512178113_veltrium
# DB_PASSWORD=VeltriumFx@2026

# ─── AUTH (Shared Secret with Nova Master for Inter-VPS Access) ─────────
JWT_SECRET=local-only-novafxm-jwt-secret-change-before-sharing
JWT_EXPIRES_IN=7d

# ─── CORS & FRONTEND ───────────────────────────────────────────────────────────
# Local: VeltriumFX frontend runs on port 8082 (NovaFXM uses 8081)
CORS_ORIGIN=http://localhost:8082,http://127.0.0.1:8082,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
FRONTEND_URL=http://localhost:8082

# ─── CANDLE SYNC ───────────────────────────────────────────────────────────────
DB_SYNC_ON_START=true
AUTO_CATCHUP_ENABLED=true
AUTO_CATCHUP_DAYS=2
AUTO_CATCHUP_THROTTLE_MS=300000
AUTO_CATCHUP_ALWAYS_RECENT=true
AUTO_CATCHUP_LOGS_ENABLED=false
AUTO_CATCHUP_DUKASCOPY_ENABLED=true
RECENT_CANDLE_LOOKBACK_MINUTES=60
RECENT_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_TIMEFRAMES=1m
LIVE_CANDLE_SAVE_SYMBOLS=
AUTO_CANDLE_CATCHUP_ENABLED=true
AUTO_CANDLE_CATCHUP_DAYS=15
AUTO_CANDLE_CATCHUP_INTERVAL_MS=86400000
AUTO_CANDLE_CATCHUP_AT=00:10
AUTO_CANDLE_CATCHUP_INITIAL_DELAY_MS=120000
AUTO_CANDLE_CATCHUP_TIMEFRAMES=1m,3m,5m,15m,1H,4H,1D,1W,1M

# ─── EMAIL ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zivico_support@revoraglobal.com
SMTP_PASS=Zivico@123456
MAIL_FROM=VeltriumFX <zivico_support@revoraglobal.com>
APP_NAME=VeltriumFX

# ─── AI SUPPORT ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6JhlT9Cwcj4i1F9f-RpOp1uWvaanffdTRyIqqEL0SK3JQ
