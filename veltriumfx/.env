   NovaFXM Production Environment (Port 5000)
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# ─── DATABASE (Hostinger Remote MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DBNAME=veltriumfx_db
DB_USER=root
DB_PASSWORD=1234

# ─── AUTH _──────────────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_novafxm_jwt_key_2026
JWT_EXPIRES_IN=7d

# ─── CORS & FRONTEND ───────────────────────────────────────────────────────────
CORS_ORIGIN=https://platform.novafxm.com,https://platform1.novafxm.com,https://platform2.novafxm.com
FRONTEND_URL=https://platform.novafxm.com

# ─── CANDLE SYNC ───────────────────────────────────────────────────────────────
DB_SYNC_ON_START=true
AUTO_CATCHUP_ENABLED=true
AUTO_CATCHUP_DAYS=2
AUTO_CATCHUP_THROTTLE_MS=300000
AUTO_CATCHUP_ALWAYS_RECENT=true
AUTO_CATCHUP_LOGS_ENABLED=false
AUTO_CATCHUP_DUKASCOPY_ENABLED=true
RECENT_CANDLE_LOOKBACK_MINUTES=60
RECENT_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_TIMEFRAMES=1m
LIVE_CANDLE_SAVE_SYMBOLS=
AUTO_CANDLE_CATCHUP_ENABLED=true
AUTO_CANDLE_CATCHUP_DAYS=15
AUTO_CANDLE_CATCHUP_INTERVAL_MS=86400000
AUTO_CANDLE_CATCHUP_AT=00:10
AUTO_CANDLE_CATCHUP_INITIAL_DELAY_MS=120000
AUTO_CANDLE_CATCHUP_TIMEFRAMES=1m,3m,5m,15m,1H,4H,1D,1W,1M

# ─── EMAIL ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zivico_support@revoraglobal.com
SMTP_PASS=Zivico@123456
MAIL_FROM=NovaFXM <zivico_support@revoraglobal.com>
APP_NAME=NovaFXM