# VeltriumFX environment configuration example
# Copy this to .env and fill in your values.

# NODE_ENV=development
# PORT=5001
# HOST=0.0.0.0

# ─── MASTER CONTROL ─────────────────────────────────────────────────────────
# Disable master role on this platform (VeltriumFX is a client-facing platform)
# ENABLE_MASTER=false

# ─── DATABASE ────────────────────────────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=novafxm_db
# DB_USER=root
# DB_PASSWORD=your_password

# ─── AUTH ────────────────────────────────────────────────────────────────────
# JWT_SECRET=replace_with_a_long_random_secret
# JWT_EXPIRES_IN=7d

# ─── CORS & FRONTEND ─────────────────────────────────────────────────────────
# CORS_ORIGIN=https://test.novafxm.com,https://novafxm.com
# FRONTEND_URL=https://test.novafxm.com

# ─── APP IDENTITY ────────────────────────────────────────────────────────────
# APP_NAME=VeltriumFX

# Read all chart candles from the NovaFXM central market-data service.
# CENTRAL_CANDLE_SOURCE=true
# CENTRAL_CANDLE_API_URL=https://server.novafxm.com/api/market/internal
# CENTRAL_CANDLE_API_KEY=the_same_secret_as_novafxm
# AUTO_CANDLE_CATCHUP_ENABLED=false
# AUTO_CATCHUP_ENABLED=false
# RECENT_CANDLE_SAVE_ENABLED=false
# LIVE_CANDLE_SAVE_ENABLED=false

# DB_SYNC_ON_START=false

# ─── EMAIL ───────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-smtp-password
# MAIL_FROM="VeltriumFX <your-email@domain.com>"

# ─── CANDLE CHART SYNC ───────────────────────────────────────────────────────
# AUTO_CATCHUP_ENABLED=true
# AUTO_CATCHUP_DAYS=2
# AUTO_CATCHUP_THROTTLE_MS=300000
# AUTO_CATCHUP_ALWAYS_RECENT=true
# AUTO_CATCHUP_LOGS_ENABLED=false
# AUTO_CATCHUP_DUKASCOPY_ENABLED=true
# RECENT_CANDLE_LOOKBACK_MINUTES=60
# RECENT_CANDLE_SAVE_ENABLED=true
# LIVE_CANDLE_SAVE_ENABLED=true
# LIVE_CANDLE_SAVE_TIMEFRAMES=1m
# LIVE_CANDLE_SAVE_SYMBOLS=

# ─── BACKGROUND CANDLE CATCHUP ───────────────────────────────────────────────
# AUTO_CANDLE_CATCHUP_ENABLED=true
# AUTO_CANDLE_CATCHUP_DAYS=2
# AUTO_CANDLE_CATCHUP_INTERVAL_MS=86400000
# AUTO_CANDLE_CATCHUP_AT=00:10
# AUTO_CANDLE_CATCHUP_INITIAL_DELAY_MS=120000
# AUTO_CANDLE_CATCHUP_TIMEFRAMES=1m,3m,5m,15m,1H,4H,1D,1W,1M

# ─── AI SUPPORT ──────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
