NODE_ENV=production
HOST=127.0.0.1
PORT=5002

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=a5markets_db
DB_USER=a5markets_user
DB_PASSWORD=replace_with_database_password

JWT_SECRET=replace_with_the_same_long_master_handoff_secret
JWT_EXPIRES_IN=7d
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_initial_admin_password

CORS_ORIGIN=https://platform.a5markets.com,https://crm.a5markets.com,https://a5markets.com,https://server.a5markets.com
FRONTEND_URL=https://platform.a5markets.com
APP_NAME=A5 Markets

DB_SYNC_ON_START=true
AUTO_CATCHUP_ENABLED=true
AUTO_CATCHUP_DAYS=2
RECENT_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_TIMEFRAMES=1m
AUTO_CANDLE_CATCHUP_ENABLED=true
AUTO_CANDLE_CATCHUP_DAYS=15
AUTO_CANDLE_CATCHUP_INTERVAL_MS=86400000
AUTO_CANDLE_CATCHUP_AT=00:10
AUTO_CANDLE_CATCHUP_INITIAL_DELAY_MS=120000
AUTO_CANDLE_CATCHUP_TIMEFRAMES=1m,3m,5m,15m,1H,4H,1D,1W,1M

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@a5markets.com
SMTP_PASS=replace_with_smtp_password
MAIL_FROM=A5 Markets <support@a5markets.com>

GEMINI_API_KEY=replace_with_api_key
