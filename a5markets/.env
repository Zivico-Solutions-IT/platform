NODE_ENV=development
HOST=0.0.0.0

PORT=5002

# ─── DATABASE ──────────────────────────────────────────────────────────────────
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=novafxm
# DB_USER=root
# DB_PASSWORD=1234

DB_HOST=187.127.213.250
DB_PORT=3306
DB_NAME=nova_db
DB_USER=nova_user
DB_PASSWORD=Lw5dwRHEp5bdA8iY

# ─── AUTH ──────────────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_novafxm_local_jwt_key_2026
JWT_EXPIRES_IN=7d

# ─── CORS & FRONTEND ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:8081

# ─── CANDLE SYNC ───────────────────────────────────────────────────────────────
DB_SYNC_ON_START=true
AUTO_CATCHUP_ENABLED=true
AUTO_CATCHUP_DAYS=2
AUTO_CATCHUP_THROTTLE_MS=300000
AUTO_CATCHUP_ALWAYS_RECENT=true
AUTO_CATCHUP_LOGS_ENABLED=false
AUTO_CATCHUP_DUKASCOPY_ENABLED=true

RECENT_CANDLE_LOOKBACK_MINUTES=60
RECENT_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_ENABLED=true
LIVE_CANDLE_SAVE_TIMEFRAMES=1m
LIVE_CANDLE_SAVE_SYMBOLS=

AUTO_CANDLE_CATCHUP_ENABLED=true
AUTO_CANDLE_CATCHUP_DAYS=15
AUTO_CANDLE_CATCHUP_INTERVAL_MS=86400000
AUTO_CANDLE_CATCHUP_AT=00:10
AUTO_CANDLE_CATCHUP_INITIAL_DELAY_MS=120000
AUTO_CANDLE_CATCHUP_TIMEFRAMES=1m,3m,5m,15m,1H,4H,1D,1W,1M

# ─── SIX-MONTH BACKFILL ────────────────────────────────────────────────────────
CANDLE_BACKFILL_DAYS=180
CANDLE_BACKFILL_TIMEFRAMES=1m,3m,5m,15m,1H,4H,1D,1W,1M

# ─── EMAIL ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@novafxm.com
SMTP_PASS=Zivico@123456
MAIL_FROM=NovaFXM <support@novafxm.com>
APP_NAME=NovaFXM


# ─── AI SUPPORT ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_EXISTING_GEMINI_API_KEY
MARKET_DATA_INTERNAL_KEY=generate_a_long_random_secret_here

