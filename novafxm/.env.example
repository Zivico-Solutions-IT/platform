# NODE_ENV=development
# PORT=3000
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=novafxm_db
# DB_USER=root
# DB_PASSWORD=1234
# JWT_SECRET=replace_with_a_long_random_secret
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=https://novafxm.com
# FRONTEND_URL=https://novafxm.com
# DB_SYNC_ON_START=false
# APP_NAME=NovaFXM

# # Gmail SMTP password reset emails
# # Use a Google App Password for SMTP_PASS, not your normal Gmail password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-google-app-password
# MAIL_FROM="NovaFXM <your-gmail-address@gmail.com>"

# # Candle chart auto catch-up
# AUTO_CATCHUP_ENABLED=true
# AUTO_CATCHUP_DAYS=2
# AUTO_CATCHUP_THROTTLE_MS=300000
# AUTO_CATCHUP_ALWAYS_RECENT=true
# AUTO_CATCHUP_LOGS_ENABLED=false
# AUTO_CATCHUP_DUKASCOPY_ENABLED=true
# RECENT_CANDLE_LOOKBACK_MINUTES=60
# DUKASCOPY_HOUR_CACHE_MS=300000
# DUKASCOPY_HOUR_ERROR_CACHE_MS=120000
# RECENT_CANDLE_SAVE_ENABLED=true
# LIVE_CANDLE_SAVE_ENABLED=true
# LIVE_CANDLE_SAVE_TIMEFRAMES=1m
# LIVE_CANDLE_SAVE_SYMBOLS=

# # Background full-provider catch-up for all app symbols
# AUTO_CANDLE_CATCHUP_ENABLED=true
# AUTO_CANDLE_CATCHUP_DAYS=2
# AUTO_CANDLE_CATCHUP_INTERVAL_MS=86400000
# AUTO_CANDLE_CATCHUP_AT=00:10
# AUTO_CANDLE_CATCHUP_INITIAL_DELAY_MS=120000
# AUTO_CANDLE_CATCHUP_TIMEFRAMES=1m,3m,5m,15m,1H,4H,1D,1W,1M

# # Binance import stability
# BINANCE_REQUEST_TIMEOUT_MS=30000
# BINANCE_REQUEST_RETRIES=5
# BINANCE_REQUEST_DELAY_MS=250
